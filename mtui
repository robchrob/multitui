#!/bin/bash
# MultiTUI — Global CLI Orchestrator
set -Eeuo pipefail
shopt -s nullglob

MTUI_VERSION="0.2.1"
MTUI_HOME="$HOME/.multitui"
REMOTE_REPO="${MTUI_REMOTE:-git@github.com:robchrob/multitui.git}"
REMOTE_BRANCH="${MTUI_BRANCH:-develop}"
OPENCODE_DEFAULT_MODEL="${MTUI_MODEL:-opencode/deepseek-v4-flash-free}"

# --- Colors & Helpers ---
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'

trap 'rc=$?; echo -e "${C_RED}[✘] error at line $LINENO: ${BASH_COMMAND}${C_RESET}" >&2; exit "$rc"' ERR

_log() { echo -e "${C_BLUE}[mtui]${C_RESET} $1"; }
_warn() { echo -e "${C_YELLOW}[!] $1${C_RESET}" >&2; }
_err() { echo -e "${C_RED}[✘] $1${C_RESET}" >&2; exit 1; }

_warn_no_agent() {
    if [[ ! -d "agent" ]]; then
        _warn "No agent/ directory found in this project."
        _warn "Run 'mtui init' or 'mtui bootstrap' to attach the agent first."
        sleep 1
    fi
}

_container_name() {
    echo "mtui-$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
}

_render_template() {
    local file="$1"
    [[ -r "$file" ]] || _err "Missing template: $file"

    local content
    content="$(cat "$file")"
    shift

    while [[ $# -gt 0 ]]; do
        local var="${1%%=*}"
        local val="${1#*=}"
        content="${content//\$\{$var\}/$val}"
        shift
    done

    printf '%s' "$content"
}

_ensure_gitignore_entry() {
    local file=".gitignore"

    touch "$file"

    for entry in "agent/"; do
        if ! grep -qxF "$entry" "$file"; then
            printf '\n%s\n' "$entry" >> "$file"
            _log "Added $entry to .gitignore"
        fi
    done
}

_project_branch() {
    if [[ -f ".mtui-branch" ]]; then
        cat ".mtui-branch"
    else
        echo "$REMOTE_BRANCH"
    fi
}

_attach() {
    local branch
    branch="$(_project_branch)"

    local agent_ok=0

    if [[ -d "agent/.git" ]]; then
        if git -C agent rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            agent_ok=1
        fi
    fi

    if [[ "$agent_ok" -ne 1 ]]; then
        _log "Agent missing or broken, re-cloning branch: $branch..."
        rm -rf agent

        # Use --no-single-branch to ensure all remote branches are available
        if ! git clone --depth 1 --no-single-branch -b "$branch" "$REMOTE_REPO" agent 2>/dev/null; then
            git clone --depth 1 --no-single-branch "$REMOTE_REPO" agent
            if [[ "$branch" != "$REMOTE_BRANCH" ]]; then
                git -C agent checkout -q "$branch" 2>/dev/null || true
            fi
        fi
    fi

    _ensure_gitignore_entry

    local current_branch
    current_branch="$(git -C agent rev-parse --abbrev-ref HEAD 2>/dev/null || echo "$REMOTE_BRANCH")"

    if [[ "$current_branch" != "$branch" ]]; then
        _log "Switching agent to branch: $branch..."
        git -C agent fetch origin -q >/dev/null 2>&1 || true
        if git rev-parse "origin/$branch" >/dev/null 2>&1; then
            git -C agent checkout -q "$branch" >/dev/null 2>&1 || \
                git -C agent checkout -b "$branch" -t origin/"$branch" -q 2>/dev/null || true
        fi
    fi

    if [[ "$branch" == "$REMOTE_BRANCH" ]]; then
        _log "Updating agent to latest $branch..."
        git -C agent fetch origin "$branch" -q >/dev/null 2>&1 || true
        git -C agent checkout -q "$branch" >/dev/null 2>&1 || true
        git -C agent reset --hard "origin/$branch" -q >/dev/null 2>&1 || true
    else
        _log "Updating agent branch $branch (safe rebase)..."
        git -C agent fetch origin "$REMOTE_BRANCH" -q >/dev/null 2>&1 || true
        git -C agent fetch origin "$branch" -q >/dev/null 2>&1 || true
        if git -C agent rebase "origin/$REMOTE_BRANCH" >/dev/null 2>&1; then
            : # rebase succeeded
        else
            _warn "Rebase conflicts detected. Resolve in agent/ then run 'mtui update --continue'"
            exit 1
        fi
    fi
}

# Build the common docker flags array used by both _run_opencode and cmd_start.
# Appends into the named array variable passed as $1.
# Usage: _build_docker_flags my_array [-p HOST:CONTAINER ...]
_build_docker_flags() {
    local -n _flags_ref="$1"
    shift

    local extra_ports=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--port)
                if [[ -z "${2:-}" ]]; then
                    _err "Option $1 requires a port mapping value (e.g., 8080:80)"
                fi
                extra_ports+=("-p" "$2")
                shift 2
                ;;
            *) shift ;;
        esac
    done

    local config_file="$PWD/agent/defaults/opencode.json"
    local config_dir="$PWD/agent/defaults"
    local use_global_config=0

    if [[ ! -f "$config_file" ]]; then
        if [[ -f "$MTUI_HOME/defaults/opencode.json" ]]; then
            config_file="$MTUI_HOME/defaults/opencode.json"
            config_dir="$MTUI_HOME/defaults"
            use_global_config=1
        fi
    fi

    _flags_ref+=(
        -v "$PWD":"$PWD"
        -w "$PWD"
        --group-add "$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"
        -v /var/run/docker.sock:/var/run/docker.sock
        -e OPENROUTER_API_KEY
        -e ZAI_API_KEY
        -e OPENCODEGO_API_KEY
        -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL"
        -e OPENCODE_CONFIG="$config_file"
        -e OPENCODE_DATA_DIR="/workspace/.opencode-data"
        -e OPENCODE_CACHE_DIR="/workspace/.opencode-cache"
        -e OPENCODE_STATE_DIR="/workspace/.opencode-state"
        -e OPENCODE_LOG_DIR="/workspace/.opencode-log"
        -e EXA_API_KEY
        -e PROJECT_ROOT="$PWD"
    )

    if [[ "$use_global_config" -eq 1 ]]; then
        _flags_ref+=(-v "$MTUI_HOME/defaults:$MTUI_HOME/defaults:ro")
    else
        _flags_ref+=(-e OPENCODE_CONFIG_DIR="$config_dir")
    fi

    [[ -f "$HOME/.config/uv/uv.toml" ]] && _flags_ref+=(-v "$HOME/.config/uv/uv.toml:/home/dev/.config/uv/uv.toml")
    [[ -f "$HOME/.bunfig.toml" ]] && _flags_ref+=(-v "$HOME/.bunfig.toml:/home/dev/.bunfig.toml")

    if [[ ${#extra_ports[@]} -gt 0 ]]; then
        _flags_ref+=("${extra_ports[@]}")
    fi
}

_run_opencode() {
    local prompt="$1"
    shift
    local flags=()
    _build_docker_flags flags "$@"

    _log "Waking up AI to analyze..."
    docker run --rm "${flags[@]}" multitui \
        opencode --model "$OPENCODE_DEFAULT_MODEL" run "$prompt"
}

# --- Core Commands ---
cmd_setup() {
    _log "Installing mtui to ~/.local/bin..."

    local mtui_link="$HOME/.local/bin/mtui"
    mkdir -p "$HOME/.local/bin"

    if [[ -f "$PWD/mtui" ]]; then
        _log "Copying local script..."
        cp "$PWD/mtui" "$mtui_link"

        # SOTA: Inject dynamic git version into the installed copy ONLY
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            local git_ver
            git_ver="$(git describe --tags --always --dirty --match "v*" 2>/dev/null || echo "$MTUI_VERSION-dev")"

            # Use sed to overwrite the version in the destination file
            # (.bak ensures macOS/BSD sed compatibility)
            sed -i.bak "s/^MTUI_VERSION=.*/MTUI_VERSION=\"$git_ver\"/" "$mtui_link"
            rm -f "${mtui_link}.bak"

            _log "Baked local dev version: $git_ver"
        fi
    else
        _log "Fetching script from GitHub..."
        local mtui_source="https://raw.githubusercontent.com/robchrob/multitui/$REMOTE_BRANCH/mtui"
        curl -fsSL "$mtui_source" -o "$mtui_link"
    fi
    chmod +x "$mtui_link"

    cmd_build

    mkdir -p "$MTUI_HOME/defaults"
    if [[ -d "defaults" ]]; then
        cp -r defaults/* "$MTUI_HOME/defaults/"
        _log "Installed global defaults to $MTUI_HOME/defaults/"
    fi

    echo -e "${C_GREEN}[✔] Setup complete! Run 'mtui' anywhere.${C_RESET}"
}

cmd_build() {
    local no_cache=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-cache) no_cache="--no-cache" ;;
        esac
        shift
    done

    local dockerfile_dir
    if [[ -f "docker/Dockerfile" ]]; then
        dockerfile_dir="$PWD/docker"
        _log "Using local docker/Dockerfile"
    else
        _log "No local Dockerfile found, fetching from GitHub..."
        local tmpdir
        tmpdir=$(mktemp -d)
        curl -fsSL "https://raw.githubusercontent.com/robchrob/multitui/$REMOTE_BRANCH/docker/Dockerfile" -o "$tmpdir/Dockerfile" || _err "Failed to fetch Dockerfile"
        dockerfile_dir="$tmpdir"
    fi

    local build_args=(
        --build-arg HOST_UID="$(id -u)"
        --build-arg HOST_GID="$(id -g)"
    )

    if docker images -q multitui | grep -q .; then
        if [[ -z "$no_cache" ]]; then
            _log "Checking for OpenCode updates..."
            local current_version latest_version
            current_version="$(docker run --rm multitui opencode --version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//' || true)"
            latest_version="$(curl -fsSL https://api.github.com/repos/anomalyco/opencode/releases/latest 2>/dev/null | jq -r '.tag_name' 2>/dev/null | sed 's/^v//' || true)"

            if [[ -n "$latest_version" && "$current_version" != "$latest_version" ]]; then
                _log "OpenCode v$current_version → v$latest_version (update available)"
                build_args+=(--build-arg "OPENCODE_VERSION=v$latest_version")
                no_cache="--no-cache"
            else
                _log "OpenCode v$current_version is up-to-date. skipping build."
                return 0
            fi
        fi
    else
        _log "No multitui image found, building fresh..."
    fi

    _log "Building multitui image..."
    docker build $no_cache \
        "${build_args[@]}" \
        -f "$dockerfile_dir/Dockerfile" \
        -t multitui "$dockerfile_dir"

    if [[ "$dockerfile_dir" == /tmp/* ]]; then
        rm -rf "$(dirname "$dockerfile_dir")"
    fi

    echo -e "${C_GREEN}[✔] Build complete.${C_RESET}"
}

cmd_init() {
    local instr="${1:-}"
    local name
    name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    _attach

    local template_file="agent/prompts/init.md"
    [[ -r "$template_file" ]] || _err "Missing prompt: $template_file"

    _run_opencode "$(_render_template "$template_file" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"
    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_bootstrap() {
    local instr="${1:-}"
    local name
    name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    _log "Step 1/3: Attaching agent..."
    _attach

    _log "Step 2/3: Rendering prompt..."
    local template_file="agent/prompts/bootstrap.md"
    [[ -r "$template_file" ]] || _err "Missing prompt: $template_file"

    local template_content
    template_content="$(_render_template "$template_file" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"

    _log "Step 3/3: Running OpenCode analysis..."
    _run_opencode "$template_content"

    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_start() {
    if [[ -z "${OPENROUTER_API_KEY:-}" && -z "${ZAI_API_KEY:-}" && -z "${OPENCODEGO_API_KEY:-}" ]]; then
        _err "Set at least one of OPENROUTER_API_KEY, ZAI_API_KEY or OPENCODEGO_API_KEY."
    fi

    local cn mode no_attach=0
    cn="$(_container_name)"
    mode="opencode"
    local port_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tty)
                mode="tty"
                shift
                ;;
            --no-attach)
                no_attach=1
                shift
                ;;
            -p|--port)
                if [[ -z "${2:-}" ]]; then
                    _err "Option $1 requires a port mapping value (e.g., 8080:80)"
                fi
                port_args+=("-p" "$2")
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    if [[ ! -d "agent" ]]; then
        if [[ "$no_attach" -eq 1 ]]; then
            _log "Starting without agent/ (using global config)..."
        else
            _log "Agent missing, attaching..."
            _attach
        fi
    fi

    docker images -q multitui | grep -q . || _err "No image. Run 'mtui build' first."

    local container_exists
    container_exists="$(docker ps -aq -f name="^/${cn}$" 2>/dev/null || true)"

    if [[ -z "$container_exists" ]]; then
        _log "Creating background container $cn..."
        local flags=(-d --name "$cn")
        _build_docker_flags flags "${port_args[@]+"${port_args[@]}"}"
        flags+=(-v "$HOME/.ssh":/home/dev/.ssh:ro)

        if [[ ${#port_args[@]} -gt 0 ]]; then
            _log "Container will be created with ports: ${port_args[*]}"
            _log "To change ports later, run 'mtui clean' first."
        fi

        docker run "${flags[@]}" multitui sleep infinity
    else
        local container_state
        container_state="$(docker inspect -f '{{.State.Status}}' "$cn" 2>/dev/null || true)"
        if [[ "$container_state" != "running" ]]; then
            _log "Starting container $cn..."
            docker start "$cn"
        fi

        if [[ ${#port_args[@]} -gt 0 ]]; then
            _warn "Ports ${port_args[*]} ignored - container already exists."
            _warn "To change ports, run 'mtui clean' first, then 'mtui start -p H:C'"
        fi
    fi

    _log "Attaching to $cn..."

    if [[ "$mode" == "tty" ]]; then
        docker exec -it "$cn" bash
    else
        if [[ -t 0 ]]; then
            docker exec -it "$cn" opencode --model "$OPENCODE_DEFAULT_MODEL"
        else
            docker exec -i "$cn" opencode --model "$OPENCODE_DEFAULT_MODEL"
        fi
    fi
}

cmd_clean() {
    local cn
    cn="$(_container_name)"
    if docker rm -f "$cn" >/dev/null 2>&1; then
        echo -e "${C_GREEN}[✔] Removed container: $cn${C_RESET}"
    else
        _log "No container found for this project ($cn)."
    fi
}

cmd_list() {
    echo -e "${C_BOLD}MultiTUI Active Projects:${C_RESET}\n"
    docker ps -a --filter "name=^mtui-" --format "table {{.Names}}\t{{.State}}\t{{.Status}}" | sed 's/^mtui-//' || true
    echo ""
}

cmd_status() {
    echo -e "${C_BOLD}Project Directory:${C_RESET}  $PWD"

    if [[ -d "agent" ]]; then
        local agent_branch
        agent_branch="$(git -C agent rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"

        if [[ -f ".mtui-branch" ]]; then
            echo -e "${C_BOLD}Agent Directory:${C_RESET}     ${C_GREEN}Attached${C_RESET} (branch: $agent_branch, tracking in .mtui-branch)"
        else
            echo -e "${C_BOLD}Agent Directory:${C_RESET}     ${C_GREEN}Attached${C_RESET} (branch: $agent_branch)"
        fi
    else
        echo -e "${C_BOLD}Agent Directory:${C_RESET}     ${C_RED}Missing${C_RESET} (Run mtui init)"
    fi

    [[ -f ".mtui-branch" ]] && \
        echo -e "${C_BOLD}Project Branch:${C_RESET}    $(cat .mtui-branch)" || \
        echo -e "${C_BOLD}Project Branch:${C_RESET}    $REMOTE_BRANCH (default)"

    local c_state
    c_state="$(docker inspect -f '{{.State.Status}}' "$(_container_name)" 2>/dev/null || echo 'Not Created')"

    if [[ "$c_state" == "running" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_GREEN}Running${C_RESET} ($(_container_name))"
    elif [[ "$c_state" == "Not Created" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_DIM}Not Created${C_RESET}"
    else
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_YELLOW}${c_state^}${C_RESET} ($(_container_name))"
    fi
}

cmd_branch_create() {
    local branch_name
    branch_name="$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g')"
    branch_name="${REMOTE_BRANCH}-${branch_name}"

    _log "Creating project branch: $branch_name..."

    if [[ ! -d "agent" ]]; then
        _log "Attaching agent ($REMOTE_BRANCH) first..."
        _attach
    fi

    local current_branch
    current_branch="$(git -C agent rev-parse --abbrev-ref HEAD 2>/dev/null)"

    # If not on base branch, switch to base branch first
    if [[ "$current_branch" != "$REMOTE_BRANCH" ]]; then
        _log "Switching from $current_branch to $REMOTE_BRANCH..."
        git -C agent fetch origin -q 2>/dev/null || true
        git -C agent checkout -q "$REMOTE_BRANCH" 2>/dev/null || \
            git -C agent checkout -b "$REMOTE_BRANCH" origin/"$REMOTE_BRANCH" -q 2>/dev/null || true
    fi

    # Now create/tracking the project branch
    git -C agent fetch origin -q 2>/dev/null || true

    # Check if branch already exists remotely
    if git -C agent rev-parse "origin/$branch_name" >/dev/null 2>&1; then
        _log "Branch $branch_name exists remotely, tracking it..."
        git -C agent checkout -q "$branch_name" 2>/dev/null || \
            git -C agent checkout -b "$branch_name" -t origin/"$branch_name" -q
    else
        git -C agent checkout -b "$branch_name" 2>/dev/null || \
            git -C agent checkout -q "$branch_name" 2>/dev/null || \
            _err "Branch $branch_name already exists locally. Delete it first or check it out manually."
        git -C agent push -u origin "$branch_name" 2>/dev/null || _err "Failed to push branch to remote"
    fi

    echo "$branch_name" > .mtui-branch
    _log "Wrote .mtui-branch"

    if [[ -d ".git" ]]; then
        if ! grep -qxF ".mtui-branch" .gitignore 2>/dev/null; then
            echo ".mtui-branch" >> .gitignore
        fi
        git add .mtui-branch 2>/dev/null || true
        git commit -m "Add .mtui-branch for project branch tracking" 2>/dev/null || true
        _log "Committed .mtui-branch to project repo"
    fi

    echo -e "${C_GREEN}[✔] Branch $branch_name created and tracked.${C_RESET}"
    _log "Run 'mtui update' to sync with $REMOTE_BRANCH"
}

cmd_branch_status() {
    if [[ -d "agent" ]]; then
        local current_branch ahead behind
        current_branch="$(git -C agent rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"

        git -C agent fetch origin -q 2>/dev/null || true

        local base_branch="$REMOTE_BRANCH"
        if [[ -f ".mtui-branch" ]]; then
            base_branch="$(cat .mtui-branch)"
        fi

        if [[ "$current_branch" != "$REMOTE_BRANCH" ]]; then
            local revs_ahead behind
            ahead="$(git -C agent rev-list --count "origin/$REMOTE_BRANCH".."$current_branch" 2>/dev/null || echo '?')"
            behind="$(git -C agent rev-list --count "$current_branch"..origin/"$REMOTE_BRANCH" 2>/dev/null || echo '?')"

            echo -e "${C_BOLD}Current branch:${C_RESET} $current_branch"
            echo -e "${C_BOLD}Base branch:${C_RESET}    $REMOTE_BRANCH"
            echo -e "${C_BOLD}Ahead of $REMOTE_BRANCH:${C_RESET} $ahead commits"
            echo -e "${C_BOLD}Behind $REMOTE_BRANCH:${C_RESET} $behind commits"
        else
            echo -e "${C_BOLD}Current branch:${C_RESET} $current_branch (tracking $REMOTE_BRANCH)"
            echo -e "${C_BOLD}Status:${C_RESET} Up to date with $REMOTE_BRANCH"
        fi

        local last_fetch
        last_fetch="$(git -C agent log -1 --format='%ci' origin/$REMOTE_BRANCH 2>/dev/null | cut -d' ' -f1,2 | cut -d'T' -f1 || echo 'unknown')"
        echo -e "${C_BOLD}Last updated:${C_RESET} $last_fetch"
    else
        _err "Agent not attached. Run 'mtui init' or 'mtui branch create' first."
    fi
}

cmd_update() {
    if [[ ! -d "agent" ]]; then
        _err "Agent not attached. Run 'mtui init' or 'mtui branch create' first."
    fi

    # Check for rebase in agent directory (not current dir)
    if [[ -f "agent/.git/rebase-merge" ]] || [[ -d "agent/.git/rebase-merge" ]]; then
        _log "Rebase in progress, continuing..."
        git -C agent rebase --continue 2>/dev/null || _err "Rebase failed. Resolve conflicts manually in agent/"
        echo -e "${C_GREEN}[✔] Rebase completed.${C_RESET}"
        return 0
    fi

    local current_branch
    current_branch="$(git -C agent rev-parse --abbrev-ref HEAD)"

    # If on base branch, just pull updates (no .mtui-branch needed)
    if [[ "$current_branch" == "$REMOTE_BRANCH" ]]; then
        _log "Updating $REMOTE_BRANCH branch..."
        git -C agent fetch origin "$REMOTE_BRANCH" -q || _err "Failed to fetch $REMOTE_BRANCH"
        git -C agent reset --hard "origin/$REMOTE_BRANCH" -q || _err "Failed to update $REMOTE_BRANCH"
        echo -e "${C_GREEN}[✔] Updated $REMOTE_BRANCH to latest.${C_RESET}"
        return 0
    fi

    # Not on base branch: look for .mtui-branch file
    if [[ ! -f ".mtui-branch" ]]; then
        _err "No .mtui-branch file. Run 'mtui branch create' first."
    fi

    local branch
    branch="$(cat .mtui-branch)"

    _log "Updating $branch from $REMOTE_BRANCH..."

    git -C agent fetch origin -q || _err "Failed to fetch from origin"
    git -C agent fetch origin "$REMOTE_BRANCH" -q || _err "Failed to fetch $REMOTE_BRANCH"
    git -C agent fetch origin "$branch" -q || true

    if [[ "$current_branch" != "$branch" ]]; then
        git -C agent checkout -q "$branch" || _err "Failed to checkout $branch"
    fi

    if git -C agent rebase "origin/$REMOTE_BRANCH" 2>&1; then
        git -C agent push -f origin "$branch" 2>/dev/null || _warn "Could not push (may not have permission)"
        echo -e "${C_GREEN}[✔] Updated $branch to latest $REMOTE_BRANCH.${C_RESET}"
    else
        _warn "Rebase conflicts detected in agent/"
        _log "Resolve conflicts in agent/, then run 'mtui update --continue'"
        return 1
    fi
}

show_help() {
    echo -e "${C_BOLD}MultiTUI (mtui ${MTUI_VERSION})${C_RESET} — OpenCode Docker Orchestrator"
    echo "Usage: mtui <command> [args]"
    echo ""
    echo -e "${C_BOLD}Global Commands:${C_RESET}"
    echo "  setup                     Install or update mtui binary"
    echo "  build [--no-cache]        Build or update the 'multitui' base Docker image"
    echo "  list, ls                  List all MultiTUI containers on this machine"
    echo ""
    echo -e "${C_BOLD}Project Commands:${C_RESET}"
    echo "  init [instruction]        Scaffold new project, attach agent/, AI generates files"
    echo "  bootstrap [instruction]   Analyze existing codebase and configure MultiTUI"
    echo "  start [--tty] [--no-attach] [-p H:C]"
    echo "                          Start or resume OpenCode container for this project"
    echo "                            --tty       Drop into bash shell instead of OpenCode"
    echo "                            --no-attach Skip agent/ clone; use global config (~/.multitui/defaults)"
    echo "                            -p H:C      Expose additional port (set at creation)"
    echo "  stop, clean               Stop and remove the container for this project"
    echo "  status                    Show health and status of current project's setup"
    echo ""
    echo -e "${C_BOLD}Branch Commands:${C_RESET}"
    echo "  branch create             Create and track a project-specific branch"
    echo "  branch status             Show branch info and divergence from $REMOTE_BRANCH"
    echo "  update [--continue]      Rebase project branch onto latest $REMOTE_BRANCH"
    echo ""
    echo -e "${C_DIM}Run 'mtui <command> --help' for more info on a command.${C_RESET}"
}

# --- Router ---
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    setup)
        cmd_setup "$@"
        ;;
    build)
        cmd_build "$@"
        ;;
    init|bootstrap)
        _warn_no_agent
        case "$COMMAND" in
            init)      cmd_init "$@" ;;
            bootstrap) cmd_bootstrap "$@" ;;
        esac
        ;;
    start)
        cmd_start "$@"
        ;;
    clean|stop)
        cmd_clean
        ;;
    list|ls)
        cmd_list
        ;;
    status)
        cmd_status
        ;;
    branch)
        case "${1:-}" in
            create)   cmd_branch_create "$@" ;;
            status)   cmd_branch_status "$@" ;;
            *)        _err "Unknown branch command: ${1:-}
Run 'mtui branch create' or 'mtui branch status'"
            ;;
        esac
        ;;
    update)
        cmd_update "$@"
        ;;
    -v|--version|version)
        echo "MultiTUI $MTUI_VERSION"
        ;;
    -h|--help)
        show_help
        ;;
    *)
        _err "Unknown command: $COMMAND
Run 'mtui --help' for usage."
        ;;
esac
