#!/bin/bash
# mtui — OpenCode Docker Runner
set -Eeuo pipefail
shopt -s nullglob

MTUI_VERSION="0.3.0"
MTUI_HOME="$HOME/.multitui"
UPSTREAM="${MTUI_UPSTREAM:-robchrob/multitui}"
UPSTREAM_BRANCH="${MTUI_UPSTREAM_BRANCH:-develop}"
OPENCODE_DEFAULT_MODEL="${MTUI_MODEL:-opencode/deepseek-v4-flash-free}"

# --- Colors & Helpers ---
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'

trap 'rc=$?; echo -e "${C_RED}[✘] error at line $LINENO: ${BASH_COMMAND}${C_RESET}" >&2; exit "$rc"' ERR

_log() { echo -e "${C_BLUE}[mtui]${C_RESET} $1"; }
_warn() { echo -e "${C_YELLOW}[!] $1${C_RESET}" >&2; }
_err() { echo -e "${C_RED}[✘] $1${C_RESET}" >&2; exit 1; }

_container_name() {
    echo "mtui-$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
}

_render_template() {
    local file="$1"
    [[ -r "$file" ]] || _err "Missing template: $file"

    local content
    content="$(cat "$file")"
    shift

    while [[ $# -gt 0 ]]; do
        local var="${1%%=*}"
        local val="${1#*=}"
        content="${content//\$\{$var\}/$val}"
        shift
    done

    printf '%s' "$content"
}

_prompt_file() {
    local name="$1"
    if [[ -f "$MTUI_HOME/prompts/$name" ]]; then
        echo "$MTUI_HOME/prompts/$name"
    elif [[ -f "$PWD/prompts/$name" ]]; then
        echo "$PWD/prompts/$name"
    else
        _err "Missing prompt template: $name (run 'mtui setup' first)"
    fi
}

# Build the common docker flags array used by both _run_opencode and cmd_start.
# Appends into the named array variable passed as $1.
# Usage: _build_docker_flags my_array [-p HOST:CONTAINER ...]
_build_docker_flags() {
    local -n _flags_ref="$1"
    shift

    local extra_ports=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--port)
                if [[ -z "${2:-}" ]]; then
                    _err "Option $1 requires a port mapping value (e.g., 8080:80)"
                fi
                extra_ports+=("-p" "$2")
                shift 2
                ;;
            *) shift ;;
        esac
    done

    # Config precedence: project-local → global ($MTUI_HOME/defaults) → image-baked
    local config_file="" config_dir="" use_global_config=0

    if [[ -f "$PWD/.multitui/opencode.json" ]]; then
        config_file="$PWD/.multitui/opencode.json"
        config_dir="$PWD/.multitui"
    elif [[ -f "$PWD/opencode.json" ]]; then
        config_file="$PWD/opencode.json"
        config_dir="$PWD"
    elif [[ -f "$MTUI_HOME/defaults/opencode.json" ]]; then
        config_file="$MTUI_HOME/defaults/opencode.json"
        config_dir="$MTUI_HOME/defaults"
        use_global_config=1
    fi

    _flags_ref+=(
        -v "$PWD":"$PWD"
        -w "$PWD"
        --group-add "$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"
        -v /var/run/docker.sock:/var/run/docker.sock
        -e OPENROUTER_API_KEY
        -e ZAI_API_KEY
        -e OPENCODEGO_API_KEY
        -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL"
        -e OPENCODE_DATA_DIR="/workspace/.opencode-data"
        -e OPENCODE_CACHE_DIR="/workspace/.opencode-cache"
        -e OPENCODE_STATE_DIR="/workspace/.opencode-state"
        -e OPENCODE_LOG_DIR="/workspace/.opencode-log"
        -e EXA_API_KEY
        -e PROJECT_ROOT="$PWD"
    )

    if [[ -n "$config_file" ]]; then
        _flags_ref+=(-e OPENCODE_CONFIG="$config_file")
        if [[ "$use_global_config" -eq 1 ]]; then
            _flags_ref+=(-v "$MTUI_HOME/defaults:$MTUI_HOME/defaults:ro")
        else
            _flags_ref+=(-e OPENCODE_CONFIG_DIR="$config_dir")
        fi
    else
        _log "Using image-baked defaults (/workspace/.opencode)"
    fi

    [[ -f "$HOME/.config/uv/uv.toml" ]] && _flags_ref+=(-v "$HOME/.config/uv/uv.toml:/home/dev/.config/uv/uv.toml")
    [[ -f "$HOME/.bunfig.toml" ]] && _flags_ref+=(-v "$HOME/.bunfig.toml:/home/dev/.bunfig.toml")

    if [[ ${#extra_ports[@]} -gt 0 ]]; then
        _flags_ref+=("${extra_ports[@]}")
    fi
}

_run_opencode() {
    local prompt="$1"
    shift
    local flags=()
    _build_docker_flags flags "$@"

    _log "Waking up AI to analyze..."
    docker run --rm "${flags[@]}" multitui \
        opencode --model "$OPENCODE_DEFAULT_MODEL" run "$prompt"
}

# --- Core Commands ---
cmd_setup() {
    _log "Installing mtui to ~/.local/bin..."

    local mtui_link="$HOME/.local/bin/mtui"
    mkdir -p "$HOME/.local/bin"

    if [[ -f "$PWD/mtui" ]]; then
        _log "Copying local script..."
        cp "$PWD/mtui" "$mtui_link"

        # SOTA: Inject dynamic git version into the installed copy ONLY
        if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            local git_ver
            git_ver="$(git describe --tags --always --dirty --match "v*" 2>/dev/null || echo "$MTUI_VERSION-dev")"

            # Use sed to overwrite the version in the destination file
            # (.bak ensures macOS/BSD sed compatibility)
            sed -i.bak "s/^MTUI_VERSION=.*/MTUI_VERSION=\"$git_ver\"/" "$mtui_link"
            rm -f "${mtui_link}.bak"

            _log "Baked local dev version: $git_ver"
        fi
    else
        _log "Fetching script from GitHub..."
        curl -fsSL "https://raw.githubusercontent.com/$UPSTREAM/$UPSTREAM_BRANCH/mtui" -o "$mtui_link"
    fi
    chmod +x "$mtui_link"

    cmd_build

    mkdir -p "$MTUI_HOME/defaults" "$MTUI_HOME/prompts"
    if [[ -d "defaults" ]]; then
        cp -r defaults/* "$MTUI_HOME/defaults/"
        _log "Installed global defaults to $MTUI_HOME/defaults/"
    fi
    if [[ -d "prompts" ]]; then
        cp -r prompts/* "$MTUI_HOME/prompts/"
        _log "Installed prompts to $MTUI_HOME/prompts/"
    fi

    echo -e "${C_GREEN}[✔] Setup complete! Run 'mtui' anywhere.${C_RESET}"
}

cmd_build() {
    local no_cache=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-cache) no_cache="--no-cache" ;;
        esac
        shift
    done

    local build_context dockerfile_dir
    if [[ -f "docker/Dockerfile" ]]; then
        dockerfile_dir="$PWD/docker"
        build_context="$PWD"
        _log "Using local docker/Dockerfile"
    else
        _log "Fetching sources from GitHub..."
        local tmpdir
        tmpdir=$(mktemp -d)
        curl -fsSL "https://github.com/$UPSTREAM/archive/refs/heads/$UPSTREAM_BRANCH.tar.gz" \
            | tar xz -C "$tmpdir" --strip-components=1 \
            || _err "Failed to fetch upstream sources"
        dockerfile_dir="$tmpdir/docker"
        build_context="$tmpdir"
    fi

    local build_args=(
        --build-arg HOST_UID="$(id -u)"
        --build-arg HOST_GID="$(id -g)"
    )

    if docker images -q multitui | grep -q .; then
        if [[ -z "$no_cache" ]]; then
            _log "Checking for OpenCode updates..."
            local current_version latest_version
            current_version="$(docker run --rm multitui opencode --version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//' || true)"
            latest_version="$(curl -fsSL https://api.github.com/repos/anomalyco/opencode/releases/latest 2>/dev/null | jq -r '.tag_name' 2>/dev/null | sed 's/^v//' || true)"

            if [[ -n "$latest_version" && "$current_version" != "$latest_version" ]]; then
                _log "OpenCode v$current_version → v$latest_version (update available)"
                build_args+=(--build-arg "OPENCODE_VERSION=v$latest_version")
                no_cache="--no-cache"
            else
                _log "OpenCode v$current_version is up-to-date. skipping build."
                [[ "$build_context" == /tmp/* ]] && rm -rf "$build_context"
                return 0
            fi
        fi
    else
        _log "No multitui image found, building fresh..."
    fi

    _log "Building multitui image..."
    docker build $no_cache \
        "${build_args[@]}" \
        -f "$dockerfile_dir/Dockerfile" \
        -t multitui "$build_context"

    if [[ "$build_context" == /tmp/* ]]; then
        rm -rf "$build_context"
    fi

    echo -e "${C_GREEN}[✔] Build complete.${C_RESET}"
}

cmd_init() {
    local instr="${1:-}"
    local name
    name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    local template_file
    template_file="$(_prompt_file init.md)"

    _run_opencode "$(_render_template "$template_file" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"
    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_bootstrap() {
    local instr="${1:-}"
    local name
    name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    local template_file
    template_file="$(_prompt_file bootstrap.md)"

    local template_content
    template_content="$(_render_template "$template_file" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"

    _log "Running OpenCode analysis..."
    _run_opencode "$template_content"

    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_start() {
    if [[ -z "${OPENROUTER_API_KEY:-}" && -z "${ZAI_API_KEY:-}" && -z "${OPENCODEGO_API_KEY:-}" ]]; then
        _err "Set at least one of OPENROUTER_API_KEY, ZAI_API_KEY or OPENCODEGO_API_KEY."
    fi

    local cn mode
    cn="$(_container_name)"
    mode="opencode"
    local port_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tty)
                mode="tty"
                shift
                ;;
            -p|--port)
                if [[ -z "${2:-}" ]]; then
                    _err "Option $1 requires a port mapping value (e.g., 8080:80)"
                fi
                port_args+=("-p" "$2")
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    docker images -q multitui | grep -q . || _err "No image. Run 'mtui build' first."

    local container_exists
    container_exists="$(docker ps -aq -f name="^/${cn}$" 2>/dev/null || true)"

    if [[ -z "$container_exists" ]]; then
        _log "Creating background container $cn..."
        local flags=(-d --name "$cn")
        _build_docker_flags flags "${port_args[@]+"${port_args[@]}"}"
        flags+=(-v "$HOME/.ssh":/home/dev/.ssh:ro)

        if [[ ${#port_args[@]} -gt 0 ]]; then
            _log "Container will be created with ports: ${port_args[*]}"
            _log "To change ports later, run 'mtui clean' first."
        fi

        docker run "${flags[@]}" multitui sleep infinity
    else
        local container_state
        container_state="$(docker inspect -f '{{.State.Status}}' "$cn" 2>/dev/null || true)"
        if [[ "$container_state" != "running" ]]; then
            _log "Starting container $cn..."
            docker start "$cn"
        fi

        if [[ ${#port_args[@]} -gt 0 ]]; then
            _warn "Ports ${port_args[*]} ignored - container already exists."
            _warn "To change ports, run 'mtui clean' first, then 'mtui start -p H:C'"
        fi
    fi

    _log "Attaching to $cn..."

    if [[ "$mode" == "tty" ]]; then
        docker exec -it "$cn" bash
    else
        if [[ -t 0 ]]; then
            docker exec -it "$cn" opencode --model "$OPENCODE_DEFAULT_MODEL"
        else
            docker exec -i "$cn" opencode --model "$OPENCODE_DEFAULT_MODEL"
        fi
    fi
}

cmd_clean() {
    local cn
    cn="$(_container_name)"
    if docker rm -f "$cn" >/dev/null 2>&1; then
        echo -e "${C_GREEN}[✔] Removed container: $cn${C_RESET}"
    else
        _log "No container found for this project ($cn)."
    fi
}

cmd_list() {
    echo -e "${C_BOLD}MultiTUI Active Projects:${C_RESET}\n"
    docker ps -a --filter "name=^mtui-" --format "table {{.Names}}\t{{.State}}\t{{.Status}}" | sed 's/^mtui-//' || true
    echo ""
}

cmd_status() {
    echo -e "${C_BOLD}Project Directory:${C_RESET}  $PWD"

    local cfg_src="image-baked (/workspace/.opencode)"
    if [[ -f "$PWD/.multitui/opencode.json" ]]; then
        cfg_src="$PWD/.multitui/opencode.json (project)"
    elif [[ -f "$PWD/opencode.json" ]]; then
        cfg_src="$PWD/opencode.json (project)"
    elif [[ -f "$MTUI_HOME/defaults/opencode.json" ]]; then
        cfg_src="$MTUI_HOME/defaults/opencode.json (global)"
    fi
    echo -e "${C_BOLD}Config Source:${C_RESET}    $cfg_src"

    local c_state
    c_state="$(docker inspect -f '{{.State.Status}}' "$(_container_name)" 2>/dev/null || echo 'Not Created')"

    if [[ "$c_state" == "running" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_GREEN}Running${C_RESET} ($(_container_name))"
    elif [[ "$c_state" == "Not Created" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_DIM}Not Created${C_RESET}"
    else
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_YELLOW}${c_state^}${C_RESET} ($(_container_name))"
    fi
}

show_help() {
    echo -e "${C_BOLD}mtui (${MTUI_VERSION})${C_RESET} — OpenCode Docker Runner"
    echo "Usage: mtui <command> [args]"
    echo ""
    echo -e "${C_BOLD}Global Commands:${C_RESET}"
    echo "  setup                     Install or update mtui binary + global defaults"
    echo "  build [--no-cache]        Build or update the 'multitui' base Docker image"
    echo "  list, ls                  List all mtui containers on this machine"
    echo ""
    echo -e "${C_BOLD}Project Commands:${C_RESET}"
    echo "  init [instruction]        Scaffold new project, AI generates files"
    echo "  bootstrap [instruction]   Analyze existing codebase and configure"
    echo "  start [--tty] [-p H:C]    Start or resume OpenCode container for this project"
    echo "                            --tty       Drop into bash shell instead of OpenCode"
    echo "                            -p H:C      Expose additional port (set at creation)"
    echo "  stop, clean               Stop and remove the container for this project"
    echo "  status                    Show health and status of current project's setup"
    echo ""
    echo -e "${C_DIM}Run 'mtui <command> --help' for more info on a command.${C_RESET}"
}

# --- Router ---
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    setup)
        cmd_setup "$@"
        ;;
    build)
        cmd_build "$@"
        ;;
    init|bootstrap)
        case "$COMMAND" in
            init)      cmd_init "$@" ;;
            bootstrap) cmd_bootstrap "$@" ;;
        esac
        ;;
    start)
        cmd_start "$@"
        ;;
    clean|stop)
        cmd_clean
        ;;
    list|ls)
        cmd_list
        ;;
    status)
        cmd_status
        ;;
    -v|--version|version)
        echo "MultiTUI $MTUI_VERSION"
        ;;
    -h|--help)
        show_help
        ;;
    *)
        _err "Unknown command: $COMMAND
Run 'mtui --help' for usage."
        ;;
esac