#!/bin/bash
# MultiTUI — Global CLI Orchestrator

# --- CRITICAL: Bash Version Check (namerefs require 4.3+) ---
if [[ "${BASH_VERSINFO[0]}" -lt 4 ]] || [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -lt 3 ]]; then
    echo -e "\033[0;31m[✘] Error: This script requires Bash 4.3 or higher for nameref support.\033[0m" >&2
    echo -e "\033[0;33m[!] You are running Bash ${BASH_VERSION:-unknown}\033[0m" >&2
    echo -e "\033[0;33m[!] On macOS, install newer Bash: brew install bash\033[0m" >&2
    exit 1
fi

set -Eeuo pipefail
shopt -s nullglob

MTUI_HOME="$HOME/.multitui"
REMOTE_REPO="git@github.com:robchrob/multitui.git"
REMOTE_BRANCH="develop-detach"
#OPENCODE_DEFAULT_MODEL="opencode/minimax-m2.5-free"
OPENCODE_DEFAULT_MODEL="opencode/qwen3.6-plus-free"

# --- Colors & Helpers ---
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'

trap 'rc=$?; echo -e "${C_RED}[✘] error at line $LINENO: ${BASH_COMMAND}${C_RESET}" >&2; exit "$rc"' ERR

_log() { echo -e "${C_BLUE}[mtui]${C_RESET} $1"; }
_warn() { echo -e "${C_YELLOW}[!] $1${C_RESET}" >&2; }
_err() { echo -e "${C_RED}[✘] $1${C_RESET}" >&2; exit 1; }

_warn_no_agent() {
    if [[ ! -d "agent" ]]; then
        _warn "No agent/ directory found in this project."
        _warn "Run 'mtui init' or 'mtui bootstrap' to attach the agent first."
        sleep 1
    fi
}

_container_name() {
    echo "mtui-$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
}

_render_template() {
    local file="$1"
    [[ -r "$file" ]] || _err "Missing template: $file"

    local content
    content="$(cat "$file")"
    shift

    while [[ $# -gt 0 ]]; do
        local var="${1%%=*}"
        local val="${1#*=}"
        content="${content//\$\{$var\}/$val}"
        shift
    done

    printf '%s' "$content"
}

_ensure_gitignore_entry() {
    local file=".gitignore"

    touch "$file"

    for entry in "agent/"; do
        if ! grep -qxF "$entry" "$file"; then
            printf '\n%s\n' "$entry" >> "$file"
            _log "Added $entry to .gitignore"
        fi
    done
}

_attach() {
    local agent_ok=0

    if [[ -d "agent/.git" ]]; then
        if git -C agent rev-parse --is-inside-work-tree >/dev/null 2>&1; then
            agent_ok=1
        fi
    fi

    if [[ "$agent_ok" -ne 1 ]]; then
        _log "Agent missing or broken, re-cloning..."
        rm -rf agent .git/modules/agent
        git config --remove-section submodule.agent >/dev/null 2>&1 || true
        git clone --depth 1 -b "$REMOTE_BRANCH" "$REMOTE_REPO" agent
    fi

    _ensure_gitignore_entry

    _log "Updating agent to latest $REMOTE_BRANCH..."
    git -C agent fetch origin "$REMOTE_BRANCH" -q >/dev/null 2>&1 || true
    git -C agent checkout -q "$REMOTE_BRANCH" >/dev/null 2>&1 || true
    git -C agent reset --hard "origin/$REMOTE_BRANCH" -q >/dev/null 2>&1 || true
}

# Build the common docker flags array used by both _run_opencode and cmd_start.
# Appends into the named array variable passed as $1.
# Usage: _build_docker_flags my_array [-p HOST:CONTAINER ...]
_build_docker_flags() {
    local -n _flags_ref="$1"
    shift

    local extra_ports=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -p|--port)
                if [[ -z "${2:-}" ]]; then
                    _err "Option $1 requires a port mapping value (e.g., 8080:80)"
                fi
                extra_ports+=("-p" "$2")
                shift 2
                ;;
            *) shift ;;
        esac
    done

    _flags_ref+=(
        -v "$PWD":"$PWD"
        -w "$PWD"
        --group-add "$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"
        -v /var/run/docker.sock:/var/run/docker.sock
        -e OPENROUTER_API_KEY
        -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL"
        -e OPENCODE_CONFIG="$PWD/defaults/opencode.json"
        -e OPENCODE_CONFIG_DIR="$PWD/defaults"
        -e GITHUB_TOKEN
        -e EXA_API_KEY
        -e PROJECT_ROOT="$PWD"
    )

    [[ -f "$HOME/.config/uv/uv.toml" ]] && _flags_ref+=(-v "$HOME/.config/uv/uv.toml:/home/dev/.config/uv/uv.toml")
    [[ -f "$HOME/.bunfig.toml" ]] && _flags_ref+=(-v "$HOME/.bunfig.toml:/home/dev/.bunfig.toml")

    if [[ ${#extra_ports[@]} -gt 0 ]]; then
        _flags_ref+=("${extra_ports[@]}")
    fi
}

_run_opencode() {
    local prompt="$1"
    shift
    local flags=()
    _build_docker_flags flags "$@"

    _log "Waking up AI to analyze..."
    docker run --rm "${flags[@]}" multitui \
        opencode --model "$OPENCODE_DEFAULT_MODEL" run "$prompt"
}

# --- Core Commands ---

cmd_setup() {
    _log "Setting up MultiTUI globally in $MTUI_HOME..."

    if [[ ! -d "$MTUI_HOME" ]]; then
        _log "Cloning framework ($REMOTE_BRANCH)..."
        git clone "$REMOTE_REPO" -b "$REMOTE_BRANCH" "$MTUI_HOME"
    else
        _log "Updating framework ($REMOTE_BRANCH)..."
        git -C "$MTUI_HOME" checkout "$REMOTE_BRANCH" -q 2>/dev/null || \
            git -C "$MTUI_HOME" checkout -B "$REMOTE_BRANCH" "origin/$REMOTE_BRANCH" -q 2>/dev/null || true
        git -C "$MTUI_HOME" pull origin "$REMOTE_BRANCH" -q 2>/dev/null || true
    fi

    _log "Linking mtui to ~/.local/bin/mtui..."
    mkdir -p "$HOME/.local/bin"
    chmod +x "$MTUI_HOME/mtui"
    ln -sf "$MTUI_HOME/mtui" "$HOME/.local/bin/mtui"

    cmd_build

    echo -e "${C_GREEN}[✔] Setup complete! Run 'mtui' anywhere.${C_RESET}"
}

cmd_build() {
    local no_cache=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-cache) no_cache="--no-cache" ;;
        esac
        shift
    done

    # Prefer agent/docker/Dockerfile from the local project clone when available,
    # so the locally-checked-out agent is actually used rather than always deferring
    # to the globally-installed ~/.multitui copy.
    local dockerfile_dir
    if [[ -f "agent/docker/Dockerfile" ]]; then
        dockerfile_dir="$PWD/agent/docker"
        _log "Using local agent/docker/Dockerfile"
    elif [[ -f "$MTUI_HOME/docker/Dockerfile" ]]; then
        dockerfile_dir="$MTUI_HOME/docker"
        _log "Using global ~/.multitui/docker/Dockerfile"
    else
        _err "No Dockerfile found. Run 'mtui setup' first, or attach an agent with 'mtui init'."
    fi

    local build_args=(
        --build-arg HOST_UID="$(id -u)"
        --build-arg HOST_GID="$(id -g)"
    )

    if docker images -q multitui | grep -q .; then
        if [[ -z "$no_cache" ]]; then
            _log "Checking for OpenCode updates..."
            local current_version latest_version
            current_version="$(docker run --rm multitui opencode --version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//' || true)"
            latest_version="$(curl -fsSL https://api.github.com/repos/anomalyco/opencode/releases/latest 2>/dev/null | jq -r '.tag_name' 2>/dev/null | sed 's/^v//' || true)"

            if [[ -n "$latest_version" && "$current_version" != "$latest_version" ]]; then
                _log "OpenCode v$current_version → v$latest_version (update available)"
                build_args+=(--build-arg "OPENCODE_VERSION=v$latest_version")
                no_cache="--no-cache"
            else
                _log "OpenCode v$current_version is up-to-date. skipping build."
                return 0
            fi
        fi
    else
        _log "No multitui image found, building fresh..."
    fi

    _log "Building multitui image..."
    docker build $no_cache \
        "${build_args[@]}" \
        -f "$dockerfile_dir/Dockerfile" \
        -t multitui "$dockerfile_dir"

    echo -e "${C_GREEN}[✔] Build complete.${C_RESET}"
}

cmd_init() {
    local instr="${1:-}"
    local name
    name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    _attach

    local template_file="agent/prompts/init.md"
    [[ -r "$template_file" ]] || _err "Missing prompt: $template_file"

    _run_opencode "$(_render_template "$template_file" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"
    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_bootstrap() {
    local instr="${1:-}"
    local name
    name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    _log "Step 1/3: Attaching agent..."
    _attach

    _log "Step 2/3: Rendering prompt..."
    local template_file="agent/prompts/bootstrap.md"
    [[ -r "$template_file" ]] || _err "Missing prompt: $template_file"

    local template_content
    template_content="$(_render_template "$template_file" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"

    _log "Step 3/3: Running OpenCode analysis..."
    _run_opencode "$template_content"

    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_start() {
    [[ -n "${OPENROUTER_API_KEY:-}" ]] || _err "OPENROUTER_API_KEY not set."

    if [[ ! -d "agent" ]]; then
        _log "Agent missing, attaching..."
        _attach
    fi

    local cn mode
    cn="$(_container_name)"
    mode="opencode"
    local port_args=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tty)
                mode="tty"
                shift
                ;;
            -p|--port)
                if [[ -z "${2:-}" ]]; then
                    _err "Option $1 requires a port mapping value (e.g., 8080:80)"
                fi
                port_args+=("-p" "$2")
                shift 2
                ;;
            *)
                shift
                ;;
        esac
    done

    docker images -q multitui | grep -q . || _err "No image. Run 'mtui build' first."

    local container_exists
    container_exists="$(docker ps -aq -f name="^/${cn}$" 2>/dev/null || true)"

    if [[ -z "$container_exists" ]]; then
        _log "Creating background container $cn..."
        local flags=(-d --name "$cn")
        _build_docker_flags flags "${port_args[@]+"${port_args[@]}"}"
        flags+=(-v "$HOME/.ssh":/home/dev/.ssh:ro)

        if [[ ${#port_args[@]} -gt 0 ]]; then
            _log "Container will be created with ports: ${port_args[*]}"
            _log "To change ports later, run 'mtui clean' first."
        fi

        docker run "${flags[@]}" multitui sleep infinity
    else
        local container_state
        container_state="$(docker inspect -f '{{.State.Status}}' "$cn" 2>/dev/null || true)"
        if [[ "$container_state" != "running" ]]; then
            _log "Starting container $cn..."
            docker start "$cn"
        fi

        if [[ ${#port_args[@]} -gt 0 ]]; then
            _warn "Ports ${port_args[*]} ignored - container already exists."
            _warn "To change ports, run 'mtui clean' first, then 'mtui start -p H:C'"
        fi
    fi

    _log "Attaching to $cn..."

    if [[ "$mode" == "tty" ]]; then
        docker exec -it "$cn" bash
    else
        docker exec -it "$cn" opencode --model "$OPENCODE_DEFAULT_MODEL"
    fi
}

cmd_clean() {
    local cn
    cn="$(_container_name)"
    if docker rm -f "$cn" >/dev/null 2>&1; then
        echo -e "${C_GREEN}[✔] Removed container: $cn${C_RESET}"
    else
        _log "No container found for this project ($cn)."
    fi
}

cmd_list() {
    echo -e "${C_BOLD}MultiTUI Active Projects:${C_RESET}\n"
    docker ps -a --filter "name=^mtui-" --format "table {{.Names}}\t{{.State}}\t{{.Status}}" | sed 's/^mtui-//' || true
    echo ""
}

cmd_status() {
    echo -e "${C_BOLD}Project Directory:${C_RESET}  $PWD"

    if [[ -d "agent" ]]; then
        local agent_branch
        agent_branch="$(git -C agent rev-parse --abbrev-ref HEAD 2>/dev/null || echo 'unknown')"
        echo -e "${C_BOLD}Agent Directory:${C_RESET}     ${C_GREEN}Attached${C_RESET} (branch: $agent_branch)"
    else
        echo -e "${C_BOLD}Agent Directory:${C_RESET}     ${C_RED}Missing${C_RESET} (Run mtui init)"
    fi

    [[ -f "AGENTS.md" ]] && \
        echo -e "${C_BOLD}AGENTS.md:${C_RESET}          ${C_GREEN}Found${C_RESET}" || \
        echo -e "${C_BOLD}AGENTS.md:${C_RESET}          ${C_YELLOW}Missing${C_RESET}"

    local c_state
    c_state="$(docker inspect -f '{{.State.Status}}' "$(_container_name)" 2>/dev/null || echo 'Not Created')"

    if [[ "$c_state" == "running" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_GREEN}Running${C_RESET} ($(_container_name))"
    elif [[ "$c_state" == "Not Created" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_DIM}Not Created${C_RESET}"
    else
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_YELLOW}${c_state^}${C_RESET} ($(_container_name))"
    fi
}

show_help() {
    echo -e "${C_BOLD}MultiTUI (mtui) — OpenCode Docker Orchestrator${C_RESET}"
    echo "Usage: mtui <command> [args]"
    echo ""
    echo -e "${C_BOLD}Global Commands:${C_RESET}"
    echo "  setup                     Install or update framework globally to ~/.multitui"
    echo "  build [--no-cache]        Build or update the 'multitui' base Docker image"
    echo "                            Prefers agent/docker/Dockerfile if present locally"
    echo "  list, ls                  List all MultiTUI containers on this machine"
    echo ""
    echo -e "${C_BOLD}Project Commands:${C_RESET}"
    echo "  init [instruction]        Scaffold new project, attach agent/, AI generates files"
    echo "  bootstrap [instruction]   Analyze existing codebase and configure MultiTUI"
    echo "  start [--tty] [-p H:C]    Start or resume OpenCode container for this project"
    echo "                            --tty   Drop into bash shell instead of OpenCode"
    echo "                            -p H:C  Expose additional port (set at creation)"
    echo "  stop, clean               Stop and remove the container for this project"
    echo "  status                    Show health and status of current project's setup"
    echo ""
    echo -e "${C_BOLD}Session Tips:${C_RESET}"
    echo "  Container runs in background - stays alive until 'mtui clean'"
    echo "  mtui start → attach to running container, start OpenCode"
    echo "  Ctrl+C / exit → detach from session, container keeps running"
    echo "  Multiple terminals can each run 'mtui start' for parallel sessions"
    echo "  mtui clean → stop container, start fresh next time"
    echo ""
    echo -e "${C_DIM}Run 'mtui <command> --help' for more info on a command.${C_RESET}"
}

# --- Router ---
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    setup)
        cmd_setup "$@"
        ;;
    build)
        cmd_build "$@"
        ;;
    init|bootstrap|start)
        _warn_no_agent
        case "$COMMAND" in
            init)      cmd_init "$@" ;;
            bootstrap) cmd_bootstrap "$@" ;;
            start)     cmd_start "$@" ;;
        esac
        ;;
    clean|stop)
        cmd_clean
        ;;
    list|ls)
        cmd_list
        ;;
    status)
        cmd_status
        ;;
    -h|--help)
        show_help
        ;;
    *)
        _err "Unknown command: $COMMAND
Run 'mtui --help' for usage."
        ;;
esac
