#!/bin/bash
# MultiTUI — Global CLI Orchestrator

set -e

MTUI_HOME="$HOME/.multitui"
REMOTE_REPO="git@github.com:robchrob/multitui.git"
REMOTE_BRANCH="develop-broken"
OPENCODE_DEFAULT_MODEL="opencode/minimax-m2.5-free"

# --- Colors & Helpers ---
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'

_log() { echo -e "${C_BLUE}[mtui]${C_RESET} $1"; }
_err() { echo -e "${C_RED}[✘] $1${C_RESET}" >&2; exit 1; }

_warn_no_agent() {
    if [[ ! -d "agent" ]]; then
        echo -e "${C_YELLOW}[!] No agent/ submodule found in this directory.${C_RESET}"
        echo -e "${C_YELLOW}    Run 'mtui init' or 'mtui bootstrap' to attach the agent first.${C_RESET}"
        sleep 1
    fi
}

_container_name() {
    echo "mtui-$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
}

_render_template() {
    local file="$1" content="$(cat "$1")"; shift
    while [[ $# -gt 0 ]]; do
        local var="${1%%=*}" val="${1#*=}"
        content="${content//\$\{$var\}/$val}"
        shift
    done
    echo "$content"
}

_attach() {
    [[ ! -d .git ]] && git init -q

    # Check if agent exists and is broken (gitlink pointing to missing gitdir)
    local needs_reset=0
    if [[ -d "agent" ]]; then
        if [[ -f "agent/.git" ]]; then
            # It's a gitlink, check if target exists
            local gitdir
            gitdir=$(cat agent/.git 2>/dev/null | sed 's/gitdir: //' 2>/dev/null || echo "")
            if [[ -z "$gitdir" ]] || [[ ! -d "$gitdir" ]]; then
                _log "Broken gitlink detected, cleaning..."
                needs_reset=1
            fi
        elif [[ ! -e "agent/.git" ]]; then
            # Directory exists but no .git at all
            _log "Agent directory missing .git, cleaning..."
            needs_reset=1
        fi

        if [[ "$needs_reset" -eq 1 ]]; then
            rm -rf agent
            # Forcefully scrub all submodule registrations
            git submodule deinit -f agent 2>/dev/null || true
            git rm --cached agent 2>/dev/null || true
            rm -rf .git/modules/agent 2>/dev/null || true
            git config --remove-section submodule.agent 2>/dev/null || true
            # Also remove from .gitmodules if present
            if [[ -f .gitmodules ]]; then
                git config --file=.gitmodules --remove-section submodule.agent 2>/dev/null || true
                git add .gitmodules 2>/dev/null || true
            fi
        fi
    fi

    # Check if submodule is registered in index but directory is missing
    if git ls-files --stage | grep -q "^160000.*agent$" && [[ ! -d "agent/.git" ]]; then
        _log "Ghost submodule registration detected, scrubbing..."
        git rm --cached agent 2>/dev/null || true
        rm -rf .git/modules/agent 2>/dev/null || true
        git config --remove-section submodule.agent 2>/dev/null || true
    fi

    # If agent doesn't exist or was cleaned, add it fresh
    if [[ ! -d "agent" ]]; then
        _log "Attaching agent/ ($REMOTE_BRANCH)..."
        git submodule add --force -b "$REMOTE_BRANCH" "$REMOTE_REPO" agent 2>&1 || {
            # If add fails, try manual initialization
            _log "Submodule add failed, trying manual setup..."
            rm -rf agent  # Ensure clean state
            git clone -b "$REMOTE_BRANCH" "$REMOTE_REPO" agent --depth 1 || true
            git submodule add --force "$REMOTE_REPO" agent 2>/dev/null || true
        }
    fi

    _log "Syncing agent/ to latest $REMOTE_BRANCH..."
    git submodule set-branch --branch "$REMOTE_BRANCH" agent 2>/dev/null || true
    git submodule sync agent 2>/dev/null || true

    # Force update the submodule to latest remote commit
    git submodule update --init --force --remote agent 2>/dev/null || {
        _log "Standard update failed, trying fallback..."
        git submodule update --init --force agent 2>/dev/null || true
    }

    # Enter agent and ensure correct branch/state
    if [[ -d "agent/.git" ]] || [[ -f "agent/.git" ]]; then
        (
            cd agent || exit 1

            # Ensure we have the full git history for the branch
            if [[ -f .git ]]; then
                # It's a gitlink, the real repo is elsewhere
                cd "$(git rev-parse --show-toplevel)" || exit 1
            fi

            # Fetch the specific branch explicitly
            git fetch origin "$REMOTE_BRANCH" -q 2>/dev/null || git fetch origin -q || true

            # Check if remote branch exists
            if git show-ref --verify --quiet "refs/remotes/origin/$REMOTE_BRANCH" 2>/dev/null; then
                # Try to checkout existing branch or create tracking branch
                if ! git checkout -q "$REMOTE_BRANCH" 2>/dev/null; then
                    git checkout -q -b "$REMOTE_BRANCH" --track "origin/$REMOTE_BRANCH" 2>/dev/null || \
                    git checkout -q -B "$REMOTE_BRANCH" "origin/$REMOTE_BRANCH" 2>/dev/null || true
                fi
                # Reset to ensure we're at the tip
                git reset --hard "origin/$REMOTE_BRANCH" -q 2>/dev/null || true
            else
                _log "${C_YELLOW}Warning: Remote branch $REMOTE_BRANCH not found, using current state${C_RESET}"
            fi
        ) || _log "${C_YELLOW}Sync warning: Could not sync agent branch.${C_RESET}"
    fi

    # CRITICAL: Always return success so set -e doesn't kill the script
    return 0
}

_scaffold() {
    _log "Scaffolding .opencode structure..."
    mkdir -p .opencode/{agents,commands,skills}

    if [[ -d "agent/defaults/skills" ]]; then
        for f in agent/defaults/skills/*/SKILL.md; do
            [[ -f "$f" ]] || continue
            local name="$(basename "$(dirname "$f")")"
            mkdir -p ".opencode/skills/$name"
            [[ ! -f ".opencode/skills/$name/SKILL.md" ]] && cp "$f" ".opencode/skills/$name/SKILL.md"
        done
    fi

    if [[ -d "agent/defaults/commands" ]]; then
        for f in agent/defaults/commands/*.md; do
            [[ -f "$f" ]] || continue
            local name="$(basename "$f" .md)"
            [[ ! -f ".opencode/commands/$name.md" ]] && cp "$f" ".opencode/commands/$name.md"
        done
    fi
}

_run_opencode() {
    local prompt="$1" prompt_file="$(mktemp)"
    printf '%s' "$prompt" > "$prompt_file"

    _log "Waking up AI to analyze..."
    docker run --rm \
        -v "$PWD":"$PWD" -w "$PWD" \
        -v "$prompt_file":/tmp/prompt.txt:ro \
        -v "$PWD/agent/config/opencode.json":/home/dev/.config/opencode/opencode.json:ro \
        --group-add "$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)" \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -e OPENROUTER_API_KEY -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL" \
        -e GITHUB_TOKEN -e EXA_API_KEY -e PROJECT_ROOT="$PWD" \
        multitui bash -c 'opencode --model "$OPENCODE_DEFAULT_MODEL" run "$(cat /tmp/prompt.txt)"'

    rm -f "$prompt_file"
}

# --- Core Commands ---

cmd_setup() {
    _log "Setting up MultiTUI globally in $MTUI_HOME..."

    if [[ ! -d "$MTUI_HOME" ]]; then
        _log "Cloning framework ($REMOTE_BRANCH)..."
        git clone "$REMOTE_REPO" -b "$REMOTE_BRANCH" "$MTUI_HOME"
    else
        _log "Updating framework ($REMOTE_BRANCH)..."
        git -C "$MTUI_HOME" checkout "$REMOTE_BRANCH" -q 2>/dev/null || \
            git -C "$MTUI_HOME" checkout -B "$REMOTE_BRANCH" "origin/$REMOTE_BRANCH" -q 2>/dev/null || true
        git -C "$MTUI_HOME" pull origin "$REMOTE_BRANCH" -q 2>/dev/null || true
    fi

    _log "Linking mtui to ~/.local/bin/mtui..."
    mkdir -p "$HOME/.local/bin"
    chmod +x "$MTUI_HOME/mtui"
    ln -sf "$MTUI_HOME/mtui" "$HOME/.local/bin/mtui"

    cmd_build

    echo -e "${C_GREEN}[✔] Setup complete! Run 'mtui' anywhere.${C_RESET}"
}

cmd_build() {
    local no_cache=""
    while [[ $# -gt 0 ]]; do
        case "$1" in --no-cache) no_cache="--no-cache" ;; esac
        shift
    done

    local build_args=(
        --build-arg HOST_UID="$(id -u)"
        --build-arg HOST_GID="$(id -g)"
    )

    if docker images -q multitui | grep -q .; then
        if [[ "$no_cache" == "" ]]; then
            _log "Checking for OpenCode updates..."
            local current_version
            current_version=$(docker run --rm multitui opencode --version 2>/dev/null | tr -d '[:space:]' | sed 's/^v//')
            local latest_version
            latest_version=$(curl -s https://api.github.com/repos/anomalyco/opencode/releases/latest | jq -r '.tag_name' | sed 's/^v//')

            if [[ -n "$latest_version" ]] && [[ "$current_version" != "$latest_version" ]]; then
                _log "OpenCode v$current_version → v$latest_version (update available)"
                build_args+=(--build-arg "OPENCODE_VERSION=v$latest_version")
                no_cache="--no-cache"
            else
                _log "OpenCode v$current_version is up-to-date. skipping build."
                return 0
            fi
        fi
    else
        _log "No multitui image found, building fresh..."
    fi

    _log "Building multitui image..."
    docker build $no_cache \
        "${build_args[@]}" \
        -f "$MTUI_HOME/docker/Dockerfile" \
        -t multitui "$MTUI_HOME/docker"
    echo -e "${C_GREEN}[✔] Build complete.${C_RESET}"
}

cmd_init() {
    local instr="${1:-}" name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    _attach || _log "Attach completed with warnings"
    _scaffold
    _run_opencode "$(_render_template "agent/defaults/templates/init.md" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"
    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_bootstrap() {
    local instr="${1:-}" name="$(basename "$PWD")"

    docker images -q multitui | grep -q . || _err "No multitui image. Run 'mtui build' first."

    _log "Step 1/4: Attaching agent..."
    _attach || _log "Attach completed with warnings"

    _log "Step 2/4: Scaffolding..."
    _scaffold

    _log "Step 3/4: Rendering template..."
    local template_content
    template_content="$(_render_template "agent/defaults/templates/bootstrap.md" "PROJECT_NAME=$name" "USER_INSTRUCTION=$instr")"

    _log "Step 4/4: Running OpenCode analysis..."
    _run_opencode "$template_content"

    echo -e "${C_GREEN}[✔] Done. Run 'mtui start'.${C_RESET}"
}

cmd_start() {
    [[ -z "$OPENROUTER_API_KEY" ]] && _err "OPENROUTER_API_KEY not set."

    # Auto-attach if missing (for resuming projects)
    [[ ! -d "agent" ]] && { _log "Agent missing, attaching..."; _attach || true; _scaffold || true; }

    local cn="$(_container_name)"
    local mode="auto"
    local flags=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tty) mode="tty"; shift ;;
            -p|--port) flags+=("-p" "$2"); shift 2 ;;
            *) shift ;;
        esac
    done

    if docker ps -aq -f name="^/${cn}$" | grep -q .; then
        local mounted="$(docker inspect "$cn" --format '{{.Config.WorkingDir}}' 2>/dev/null)"
        if [[ "$mounted" != "$PWD" ]]; then
            _err "Container $cn exists but belongs to a different path: $mounted\nRun 'mtui clean' first to remove it."
        fi
        _log "Resuming $cn..."
        exec docker start -ai "$cn"
    fi

    docker images -q multitui | grep -q . || _err "No image. Run 'mtui build' first."
    _log "Starting OpenCode..."

    flags+=(
        -it --name "$cn" --detach-keys="ctrl-z"
        -v "$PWD":"$PWD" -w "$PWD"
        -v "$PWD/agent/config/opencode.json":/home/dev/.config/opencode/opencode.json:ro
        --group-add "$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"
        -v /var/run/docker.sock:/var/run/docker.sock
        -v "$HOME/.ssh":/home/dev/.ssh:ro
        -e OPENROUTER_API_KEY -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL"
        -e GITHUB_TOKEN -e EXA_API_KEY -e PROJECT_ROOT="$PWD"
    )

    if [ "$mode" = "tty" ]; then
        exec docker run "${flags[@]}" multitui bash
    else
        exec docker run "${flags[@]}" multitui bash -c "cd '$PWD' && opencode --model \"$OPENCODE_DEFAULT_MODEL\""
    fi
}

cmd_clean() {
    local cn="$(_container_name)"
    if docker rm -f "$cn" 2>/dev/null >/dev/null; then
        echo -e "${C_GREEN}[✔] Removed container: $cn${C_RESET}"
    else
        _log "No container found for this project ($cn)."
    fi
}

cmd_list() {
    echo -e "${C_BOLD}MultiTUI Active Projects:${C_RESET}\n"
    docker ps -a --filter "name=^mtui-" --format "table {{.Names}}\t{{.State}}\t{{.Status}}" | sed 's/mtui-//' | \
    awk 'NR==1 {print "\033[1m" $0 "\033[0m"}; NR>1 {print $0}'
    echo ""
}

cmd_status() {
    echo -e "${C_BOLD}Project Directory:${C_RESET}  $PWD"

    if [[ -d "agent" ]]; then
        local sub_stat="$(git submodule status agent 2>/dev/null || echo 'Unknown')"
        echo -e "${C_BOLD}Agent Submodule:${C_RESET}    ${C_GREEN}Attached${C_RESET} ($sub_stat)"
    else
        echo -e "${C_BOLD}Agent Submodule:${C_RESET}    ${C_RED}Missing${C_RESET} (Run mtui init)"
    fi

    [[ -f "AGENTS.md" ]] && echo -e "${C_BOLD}AGENTS.md:${C_RESET}          ${C_GREEN}Found${C_RESET}" || echo -e "${C_BOLD}AGENTS.md:${C_RESET}          ${C_YELLOW}Missing${C_RESET}"

    local c_state="$(docker inspect -f '{{.State.Status}}' "$(_container_name)" 2>/dev/null || echo 'Not Created')"

    if [[ "$c_state" == "running" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_GREEN}Running${C_RESET} ($(_container_name))"
    elif [[ "$c_state" == "Not Created" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_DIM}Not Created${C_RESET}"
    else
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_YELLOW}${c_state^}${C_RESET} ($(_container_name))"
    fi
}

show_help() {
    echo -e "${C_BOLD}MultiTUI (mtui) — OpenCode Docker Orchestrator${C_RESET}"
    echo "Usage: mtui <command> [args]"
    echo ""
    echo -e "${C_BOLD}Global Commands:${C_RESET}"
    echo "  setup                 Install or update framework globally to ~/.multitui"
    echo "  build [--no-cache]    Build the 'multitui' base Docker image"
    echo "  list, ls              List all MultiTUI containers on this machine"
    echo ""
    echo -e "${C_BOLD}Project Commands:${C_RESET}"
    echo "  init [stack]          Scaffold a new project, attach agent, AI generates files"
    echo "  bootstrap [instr]     Analyze existing codebase and configure MultiTUI"
    echo "  start [--tty] [-p]    Start or resume the OpenCode container for this project"
    echo "  stop, clean           Stop and remove the container for this project"
    echo "  status                Show health and status of current directory's MultiTUI setup"
    echo ""
    echo -e "${C_DIM}Run 'mtui <command> --help' for more info on a command.${C_RESET}"
}

# --- Router ---
if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    setup)       cmd_setup "$@" ;;
    build)       cmd_build "$@" ;;
    init|bootstrap|start)
                _warn_no_agent
                case "$COMMAND" in
                    init)        cmd_init "$@" ;;
                    bootstrap)   cmd_bootstrap "$@" ;;
                    start)       cmd_start "$@" ;;
                esac
                ;;
    clean|stop)  cmd_clean ;;
    list|ls)     cmd_list ;;
    status)      cmd_status ;;
    -h|--help)   show_help ;;
    *)
        _err "Unknown command: $COMMAND\nRun 'mtui --help' for usage."
        ;;
esac
