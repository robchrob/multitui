#!/bin/bash
# MultiTUI — Global CLI Orchestrator

set -e

# ============================================================================
# DELEGATE TO SUBMODULE (WRAPPER PATTERN)
# ============================================================================
# If running globally, but the local project has its own pinned agent/mtui,
# delegate execution to the local one to ensure version lock.
if [[ "${MTUI_DISPATCHED:-0}" != "1" ]] && [[ -x "agent/mtui" ]]; then
    export MTUI_DISPATCHED=1
    exec "agent/mtui" "$@"
fi

# ============================================================================
# CONFIGURATION & GLOBALS
# ============================================================================
GLOBAL_DIR="${MTUI_HOME:-$HOME/.multitui}"
AGENT_DIR="agent"
OPENCODE_DEFAULT_MODEL="opencode/minimax-m2.5-free"
REMOTE_REPO="https://github.com/anomalyco/multitui.git" # Update if needed

# Colors
C_RESET='\033[0m'
C_RED='\033[0;31m'
C_GREEN='\033[0;32m'
C_YELLOW='\033[0;33m'
C_BLUE='\033[0;34m'
C_BOLD='\033[1m'
C_DIM='\033[2m'

# ============================================================================
# HELPER FUNCTIONS
# ============================================================================
_log()     { echo -e "${C_BLUE}[mtui]${C_RESET} $1"; }
_success() { echo -e "${C_GREEN}[✔] $1${C_RESET}"; }
_warn()    { echo -e "${C_YELLOW}[!] $1${C_RESET}"; }
_err()     { echo -e "${C_RED}[✘] $1${C_RESET}" >&2; exit 1; }

_check_docker() {
    if ! docker info >/dev/null 2>&1; then
        _err "Docker daemon is not running or not accessible."
    fi
}

_has_image() {
    docker images -q multitui 2>/dev/null | grep -q .
}

_container_name() {
    echo "mtui-$(basename "$PWD" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g')"
}

_write_if_missing() {
    local f="$1"
    [[ ! -f "$f" ]] && cat > "$f" || cat > /dev/null
}

_append_gitignore() {
    local m="# MultiTUI"
    if [[ ! -f .gitignore ]] || ! grep -qF "$m" .gitignore; then
        cat >> .gitignore <<'GI'

# MultiTUI
opencode.json
.opencode/
GI
    fi
}

_render_template() {
    local file="$1"
    local content
    content="$(cat "$file")"
    shift
    while [[ $# -gt 0 ]]; do
        local var="${1%%=*}" val="${1#*=}"
        content="${content//\$\{$var\}/$val}"
        shift
    done
    echo "$content"
}

_scaffold_project() {
    _log "Scaffolding local project files..."
    mkdir -p .opencode/{agents,commands,skills}

    # Install skills from the local submodule
    for f in "$AGENT_DIR"/defaults/skills/*/SKILL.md; do
        [[ -f "$f" ]] || continue
        local skill_name="$(basename "$(dirname "$f")")"
        mkdir -p ".opencode/skills/$skill_name"
        _write_if_missing ".opencode/skills/$skill_name/SKILL.md" < "$f"
    done

    # Install commands
    for f in "$AGENT_DIR"/defaults/commands/*.md; do
        [[ -f "$f" ]] || continue
        local cmd_name="$(basename "$f" .md)"
        _write_if_missing ".opencode/commands/$cmd_name.md" < "$f"
    done

    _append_gitignore
}

_attach_submodule() {
    if [[ ! -d .git ]]; then
        _log "Initializing git repository..."
        git init -q
    fi
    if [[ ! -d "$AGENT_DIR" ]]; then
        _log "Attaching MultiTUI submodule to $AGENT_DIR/ ..."
        git submodule add -q "$REMOTE_REPO" "$AGENT_DIR" || true
        git submodule update --init --recursive -q
        _success "Submodule attached."
    else
        _log "Submodule agent/ already exists."
    fi
}

_run_opencode_headless() {
    local prompt="$1"
    local proj_dir="$PWD"
    local gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"
    local prompt_file="$(mktemp)"

    printf '%s' "$prompt" > "$prompt_file"

    _log "Waking up OpenCode to analyze and generate..."
    docker run --rm \
        -v "$proj_dir":"$proj_dir" \
        -v "$prompt_file":/tmp/prompt.txt:ro \
        -v "$AGENT_DIR/config/opencode.json":/home/dev/.config/opencode/opencode.json:ro \
        --group-add "$gid" \
        -v /var/run/docker.sock:/var/run/docker.sock \
        -e OPENROUTER_API_KEY \
        -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL" \
        -e GITHUB_TOKEN -e EXA_API_KEY \
        -e PROJECT_ROOT="$proj_dir" \
        -w "$proj_dir" \
        multitui bash -lc 'export PATH="/home/dev/.opencode/bin:$PATH" && opencode --model "$OPENCODE_DEFAULT_MODEL" run "$(cat /tmp/prompt.txt)"'

    rm -f "$prompt_file"
}

# ============================================================================
# CLI COMMANDS
# ============================================================================

cmd_setup() {
    _log "Setting up MultiTUI globally..."
    if [[ ! -d "$GLOBAL_DIR" ]]; then
        _log "Cloning $REMOTE_REPO to $GLOBAL_DIR..."
        git clone "$REMOTE_REPO" "$GLOBAL_DIR"
    else
        _log "Updating $GLOBAL_DIR..."
        git -C "$GLOBAL_DIR" pull
    fi

    _log "Linking mtui to ~/.local/bin..."
    mkdir -p "$HOME/.local/bin"
    ln -sf "$GLOBAL_DIR/mtui" "$HOME/.local/bin/mtui"
    chmod +x "$GLOBAL_DIR/mtui"

    cmd_build
    _success "MultiTUI is installed and linked. You can now use 'mtui' anywhere."
}

cmd_build() {
    _check_docker
    _log "Building multitui base Docker image..."

    # Check if developing locally, else use global dir
    local build_dir="$GLOBAL_DIR/docker"
    if [[ ! -d "$build_dir" && -d "$PWD/docker" ]]; then
        build_dir="$PWD/docker"
        _log "Using local docker directory for build..."
    elif [[ ! -d "$build_dir" ]]; then
        _err "Global directory $GLOBAL_DIR not found. Run 'mtui setup' first."
    fi

    docker build \
        --build-arg HOST_UID="$(id -u)" \
        --build-arg HOST_GID="$(id -g)" \
        -f "$build_dir/Dockerfile" \
        -t multitui "$build_dir"

    _success "Image 'multitui' built successfully."
}

cmd_init() {
    local stack_desc="${1:-}"
    local proj_name="$(basename "$PWD")"

    _attach_submodule
    _scaffold_project

    if [[ -n "$stack_desc" ]] && _has_image; then
        _log "Generating project files for: $stack_desc"
        local prompt=$(_render_template "$AGENT_DIR/defaults/templates/init.md" "PROJECT_NAME=$proj_name" "STACK=$stack_desc")
        _run_opencode_headless "$prompt"
        _success "Project initialized!"
        _log "Check generated files: AGENTS.md, Dockerfile, docker-compose.yml"
        _log "Next: Run 'mtui start'"
    elif [[ -n "$stack_desc" ]]; then
        _warn "No multitui image yet. Run 'mtui build' to enable AI generation."
        _render_template "$AGENT_DIR/defaults/templates/fallback-agents-md.md" "PROJECT_NAME=$proj_name" "STACK=$stack_desc" > AGENTS.md
        _success "Wrote basic AGENTS.md. Run 'mtui start' to continue."
    else
        _render_template "$AGENT_DIR/defaults/templates/fallback-agents-md.md" "PROJECT_NAME=$proj_name" "STACK=" > AGENTS.md
        _success "Scaffolded locally. Use 'mtui start' and describe your stack to the AI."
    fi
}

cmd_bootstrap() {
    local user_instruction="${1:-}"
    local proj_name="$(basename "$PWD")"

    _attach_submodule
    _scaffold_project

    if _has_image; then
        _log "Analyzing existing project with AI..."
        local prompt=$(_render_template "$AGENT_DIR/defaults/templates/bootstrap.md" "PROJECT_NAME=$proj_name" "USER_INSTRUCTION=$user_instruction")
        _run_opencode_headless "$prompt"
        _success "Bootstrap complete! Run 'mtui start' to begin."
    else
        local info=""
        [[ -f package.json ]] && info="JS/TS"
        [[ -f pyproject.toml || -f requirements.txt ]] && info="${info:+$info + }Python"
        _render_template "$AGENT_DIR/defaults/templates/fallback-agents-md.md" "PROJECT_NAME=$proj_name" "STACK=${info:-unknown stack}" > AGENTS.md
        _warn "Basic bootstrap done. For AI analysis, run 'mtui build' then 'mtui bootstrap'."
    fi
}

cmd_start() {
    _check_docker
    if [[ -z "${OPENROUTER_API_KEY:-}" ]]; then
        _err "OPENROUTER_API_KEY is not set in your environment."
    fi

    local mode="auto"
    local port_flags=()

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --tty) mode="tty"; shift ;;
            -p|--port) port_flags+=("-p" "$2"); shift 2 ;;
            *) shift ;;
        esac
    done

    local proj_dir="$PWD"
    local cn="$(_container_name)"
    local docker_gid="$(stat -c '%g' /var/run/docker.sock 2>/dev/null || echo 0)"

    # Check if container exists
    if docker ps -aq -f name="^/${cn}$" | grep -q .; then
        local mounted="$(docker inspect "$cn" --format '{{.Config.WorkingDir}}' 2>/dev/null)"
        if [[ "$mounted" != "$proj_dir" ]]; then
            _err "Container $cn exists but belongs to a different project: $mounted\nRun 'mtui clean' first."
        fi
        _log "Resuming container: $cn"
        docker start -ai "$cn"
        return
    fi

    _has_image || _err "No multitui base image. Run 'mtui build' first."

    # If the user is running mtui inside the raw framework folder (oc_port), fallback directly
    # Otherwise, enforce submodule presence.
    local config_path="$proj_dir/$AGENT_DIR/config/opencode.json"
    if [[ ! -d "$AGENT_DIR" ]]; then
        if [[ -f "$proj_dir/config/opencode.json" ]]; then
            config_path="$proj_dir/config/opencode.json"
        else
            _err "No agent/ submodule found in this directory. Run 'mtui init' first."
        fi
    fi

    local flags=(
        -it --name "$cn" --detach-keys="ctrl-z"
        -v "$proj_dir":"$proj_dir"
        -v "$config_path":/home/dev/.config/opencode/opencode.json:ro
        --group-add "$docker_gid"
        -v /var/run/docker.sock:/var/run/docker.sock
        -v "$HOME/.ssh":/home/dev/.ssh:ro
        -e OPENROUTER_API_KEY -e OPENCODE_DEFAULT_MODEL="$OPENCODE_DEFAULT_MODEL"
        -e GITHUB_TOKEN -e GITHUB_KEY -e GITHUB_USER -e EXA_API_KEY
        -e PROJECT_ROOT="$proj_dir"
        -w "$proj_dir"
        "${port_flags[@]}"
    )

    _log "Starting OpenCode..."
    if [ "$mode" = "tty" ]; then
        docker run "${flags[@]}" multitui bash
    else
        docker run "${flags[@]}" multitui bash -lc "export PATH='/home/dev/.opencode/bin:\$PATH' && cd '$proj_dir' && opencode --model \"$OPENCODE_DEFAULT_MODEL\""
    fi
}

cmd_clean() {
    local cn="$(_container_name)"
    if docker rm -f "$cn" 2>/dev/null >/dev/null; then
        _success "Removed container: $cn"
    else
        _log "No container found for this project ($cn)."
    fi
}

cmd_list() {
    _check_docker
    echo -e "${C_BOLD}MultiTUI Active Projects:${C_RESET}\n"
    # Format table natively using Docker
    docker ps -a --filter "name=^mtui-" --format "table {{.Names}}\t{{.State}}\t{{.Status}}" | sed 's/mtui-//' | \
    awk 'NR==1 {print "\033[1m" $0 "\033[0m"}; NR>1 {print $0}'
    echo ""
}

cmd_status() {
    _check_docker
    echo -e "${C_BOLD}Project Directory:${C_RESET}  $PWD"

    # Submodule check
    if [[ -d "$AGENT_DIR" ]]; then
        local sub_stat="$(git submodule status "$AGENT_DIR" 2>/dev/null || echo 'Unknown')"
        echo -e "${C_BOLD}Agent Submodule:${C_RESET}    ${C_GREEN}Attached${C_RESET} ($sub_stat)"
    else
        echo -e "${C_BOLD}Agent Submodule:${C_RESET}    ${C_RED}Missing${C_RESET} (Run mtui init)"
    fi

    # Config checks
    [[ -f "AGENTS.md" ]] && echo -e "${C_BOLD}AGENTS.md:${C_RESET}          ${C_GREEN}Found${C_RESET}" || echo -e "${C_BOLD}AGENTS.md:${C_RESET}          ${C_YELLOW}Missing${C_RESET}"

    # Docker checks
    local cn="$(_container_name)"
    local c_state="$(docker inspect -f '{{.State.Status}}' "$cn" 2>/dev/null || echo 'Not Created')"

    if [[ "$c_state" == "running" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_GREEN}Running${C_RESET} ($cn)"
    elif [[ "$c_state" == "Not Created" ]]; then
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_DIM}Not Created${C_RESET}"
    else
        echo -e "${C_BOLD}Container Status:${C_RESET}   ${C_YELLOW}${c_state^}${C_RESET} ($cn)"
    fi
}

cmd_update() {
    _log "Updating global MultiTUI CLI..."
    if [[ -d "$GLOBAL_DIR/.git" ]]; then
        git -C "$GLOBAL_DIR" pull
        _success "Global framework updated."
    else
        _warn "Global framework not linked via Git at $GLOBAL_DIR."
    fi

    if [[ -d "$AGENT_DIR/.git" ]]; then
        _log "Updating local project submodule..."
        git submodule update --remote "$AGENT_DIR"
        _success "Project submodule updated."
    fi

    _log "Rebuilding base Docker image..."
    cmd_build
}

# ============================================================================
# ENTRY POINT & ROUTER
# ============================================================================
show_help() {
    echo -e "${C_BOLD}MultiTUI (mtui) — OpenCode Docker Orchestrator${C_RESET}"
    echo "Usage: mtui <command> [args]"
    echo ""
    echo -e "${C_BOLD}Global Commands:${C_RESET}"
    echo "  setup                 Install / Clone framework globally to ~/.multitui"
    echo "  build                 Build the 'multitui' base Docker image"
    echo "  list, ls              List all MultiTUI containers on this machine"
    echo "  update                Update the global CLI, local submodule, and rebuild image"
    echo ""
    echo -e "${C_BOLD}Project Commands:${C_RESET}"
    echo "  init[stack]          Scaffold a new project, attach agent, AI generates files"
    echo "  bootstrap [instr]     Analyze existing codebase and configure MultiTUI"
    echo "  start [--tty] [-p]    Start or resume the OpenCode container for this project"
    echo "  stop, clean           Stop and remove the container for this project"
    echo "  status                Show health and status of current directory's MultiTUI setup"
    echo ""
    echo -e "${C_DIM}Run 'mtui <command> --help' for more info on a command.${C_RESET}"
}

if [[ $# -eq 0 ]]; then
    show_help
    exit 0
fi

COMMAND="$1"
shift

case "$COMMAND" in
    setup)       cmd_setup "$@" ;;
    build)       cmd_build "$@" ;;
    init)        cmd_init "$@" ;;
    bootstrap)   cmd_bootstrap "$@" ;;
    start)       cmd_start "$@" ;;
    clean|stop)  cmd_clean "$@" ;;
    list|ls)     cmd_list "$@" ;;
    status)      cmd_status "$@" ;;
    update)      cmd_update "$@" ;;
    -h|--help)   show_help ;;
    *)
        _err "Unknown command: $COMMAND\nRun 'mtui --help' for usage."
        ;;
esac
