{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:MTUI_MODEL}",
  "provider": {
    "zai-coding-plan": {
      "name": "Z.AI Coding Plan",
      "api": "https://api.z.ai/api/coding/paas/v4",
      "env": ["ZAI_API_KEY"],
      "models": {
        "glm-5.3": {
          "name": "GLM 5.3",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        },
        "glm-5-turbo": {
          "name": "GLM 5 Turbo",
          "limit": {
            "context": 204800,
            "output": 65536
          }
        }
      }
    },
    "openrouter": {
      "name": "OpenRouter",
      "api": "https://openrouter.ai/api/v1",
      "env": ["OPENROUTER_API_KEY"]
    },
    "opencode-go": {
      "name": "OpenCode GO",
      "api": "https://opencode.ai/zen/go/v1/chat/completions",
      "env": ["OPENCODEGO_API_KEY"]
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "docker *": "allow",
      "docker-compose *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "uv *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "tsx *": "allow",
      "ruff *": "allow",
      "pytest *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "tee *": "allow",
      "xargs *": "allow",
      "diff *": "allow",
      "patch *": "allow",
      "tar *": "allow",
      "chmod *": "allow",
      "chown *": "allow",
      "env *": "allow",
      "which *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "date *": "allow",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/": "deny",
      "rm -rf .": "deny",
      "sudo rm *": "deny",
      "git reset --hard": "deny",
      "git push --force": "deny",
      "git push -f": "deny",
      "git push * --force": "deny",
      "git push * -f": "deny",
      "DROP *": "deny",
      "TRUNCATE *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "secrets/**": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "patch": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "*": "allow"
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "enabled": true,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "{env:PROJECT_ROOT}"],
      "enabled": true
    },
    "a2a-search": {
      "type": "local",
      "command": ["npx", "-y", "a2asearch-mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "docker",
        "container",
        "run",
        "-i",
        "--rm",
        "--network",
        "host",
        "mcr.microsoft.com/playwright/mcp"
      ],
      "enabled": true
    }
  }
}
