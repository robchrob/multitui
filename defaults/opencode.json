{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:MTUI_MODEL}",
  "permission": {
    "bash": {
      "*": "allow",
      "git *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "bun *": "allow",
      "docker *": "allow",
      "docker-compose *": "allow",
      "cat *": "allow",
      "ls *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "tree *": "allow",
      "mkdir *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "touch *": "allow",
      "echo *": "allow",
      "cd *": "allow",
      "pwd": "allow",
      "python *": "allow",
      "python3 *": "allow",
      "uv *": "allow",
      "node *": "allow",
      "npx *": "allow",
      "tsx *": "allow",
      "ruff *": "allow",
      "pytest *": "allow",
      "curl *": "allow",
      "wget *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "sort *": "allow",
      "uniq *": "allow",
      "tee *": "allow",
      "xargs *": "allow",
      "diff *": "allow",
      "patch *": "allow",
      "tar *": "allow",
      "chmod *": "allow",
      "chown *": "allow",
      "env *": "allow",
      "which *": "allow",
      "dirname *": "allow",
      "basename *": "allow",
      "realpath *": "allow",
      "date *": "allow",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/": "deny",
      "rm -rf .": "deny",
      "sudo rm *": "deny",
      "git reset --hard": "deny",
      "git push --force": "deny",
      "git push -f": "deny",
      "git push * --force": "deny",
      "git push * -f": "deny",
      "DROP *": "deny",
      "TRUNCATE *": "deny"
    },
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      ".env": "deny",
      ".env.*": "deny",
      "secrets/**": "deny"
    },
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "patch": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "codesearch": "allow",
    "task": "allow",
    "skill": "allow",
    "lsp": "allow",
    "todowrite": "allow",
    "todoread": "allow",
    "external_directory": "deny",
    "*": "allow"
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp@latest"],
      "enabled": true
    },
    "exa": {
      "type": "local",
      "command": ["npx", "-y", "exa-mcp-server"],
      "enabled": true,
      "environment": {
        "EXA_API_KEY": "{env:EXA_API_KEY}"
      }
    },
    "deepwiki": {
      "type": "remote",
      "url": "https://mcp.deepwiki.com/mcp",
      "enabled": true
    },
    "filesystem": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-filesystem", "{env:PROJECT_ROOT}"],
      "enabled": true
    },
    "git": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-git"],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-fetch"],
      "enabled": true
    },
    "time": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-time"],
      "enabled": true
    },
    "a2a-search": {
      "type": "local",
      "command": ["npx", "-y", "a2asearch-mcp"],
      "enabled": true
    }
  }
}
